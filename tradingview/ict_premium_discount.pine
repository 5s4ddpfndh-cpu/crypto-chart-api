// ICT Premium / Discount: the dealing range (last impulse leg that broke structure) split at equilibrium 50%
//@version=5
indicator("ICT Premium / Discount", "ICT Premium/Discount", overlay = true, max_boxes_count = 50, max_lines_count = 50, max_labels_count = 50, max_bars_back = 500)

swingLen  = input.int(5, "Swing length", minval = 2, maxval = 50, tooltip = "The dealing range is the last impulse leg that broke structure.")
confirmBy = input.string("Close", "Break confirmation", options = ["Close", "Wick"])
showQ     = input.bool(false, "Show quarter levels (25% / 75%)")
premCol   = input.color(color.new(#F23645, 90), "Premium", inline = "c")
discCol   = input.color(color.new(#089981, 90), "Discount", inline = "c")
eqCol     = input.color(#787B86, "Equilibrium", inline = "c")

TRANSP = color.new(color.white, 100)
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float shPrice    = na
var int   shBar      = na
var bool  shDone     = true
var float slPrice    = na
var int   slBar      = na
var bool  slDone     = true
var float legHigh    = na
var float legLow     = na
var int   legHighBar = na
var int   legLowBar  = na

if not na(ph)
    shPrice := ph
    shBar   := bar_index - swingLen
    shDone  := false
if not na(pl)
    slPrice := pl
    slBar   := bar_index - swingLen
    slDone  := false

upSrc = confirmBy == "Close" ? close : high
dnSrc = confirmBy == "Close" ? close : low

// Bullish break: the leg runs from the lowest low since the broken swing high
if not shDone and upSrc > shPrice
    shDone := true
    n = math.min(bar_index - shBar, 450)
    float v = na
    int   k = na
    for i = 0 to n
        if na(v) or low[i] < v
            v := low[i]
            k := i
    legLow     := v
    legLowBar  := bar_index - k
    legHigh    := high
    legHighBar := bar_index

// Bearish break: the leg runs from the highest high since the broken swing low
if not slDone and dnSrc < slPrice
    slDone := true
    n = math.min(bar_index - slBar, 450)
    float v = na
    int   k = na
    for i = 0 to n
        if na(v) or high[i] > v
            v := high[i]
            k := i
    legHigh    := v
    legHighBar := bar_index - k
    legLow     := low
    legLowBar  := bar_index

if not na(legHigh) and high > legHigh
    legHigh    := high
    legHighBar := bar_index
if not na(legLow) and low < legLow
    legLow    := low
    legLowBar := bar_index

eqLevel = (legHigh + legLow) / 2

var box   premBx = na
var box   discBx = na
var line  eqLn   = na
var label eqLb   = na
var line  q1Ln   = na
var line  q3Ln   = na

if barstate.islast
    box.delete(premBx)
    box.delete(discBx)
    line.delete(eqLn)
    label.delete(eqLb)
    line.delete(q1Ln)
    line.delete(q3Ln)
    rng = legHigh - legLow
    if not na(rng) and rng > 0
        x1 = math.max(math.min(legHighBar, legLowBar), bar_index - 4999)
        x2 = bar_index + 10
        premBx := box.new(x1, legHigh, x2, eqLevel, border_color = TRANSP, bgcolor = premCol, text = "Premium (sell zone)", text_color = color.new(premCol, 20), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        discBx := box.new(x1, eqLevel, x2, legLow, border_color = TRANSP, bgcolor = discCol, text = "Discount (buy zone)", text_color = color.new(discCol, 20), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        eqLn   := line.new(x1, eqLevel, x2, eqLevel, color = eqCol, style = line.style_dashed)
        eqLb   := label.new(x2, eqLevel, "Equilibrium 50%", color = TRANSP, textcolor = eqCol, style = label.style_label_left, size = size.small)
        if showQ
            q1Ln := line.new(x1, legLow + rng * 0.25, x2, legLow + rng * 0.25, color = eqCol, style = line.style_dotted)
            q3Ln := line.new(x1, legLow + rng * 0.75, x2, legLow + rng * 0.75, color = eqCol, style = line.style_dotted)

alertcondition(ta.crossunder(close, eqLevel), "Price entered discount", "ICT: price moved into discount on {{ticker}} ({{interval}})")
alertcondition(ta.crossover(close, eqLevel), "Price entered premium", "ICT: price moved into premium on {{ticker}} ({{interval}})")
