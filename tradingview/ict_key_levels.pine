// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ICT Key Levels: previous day / week / month highs and lows, and IPDA 20 / 40 / 60 day ranges
//@version=5
indicator("ICT Key Levels (PDH / PDL / PWH / PWL / PMH / PML / IPDA)", "ICT Levels", overlay = true, max_lines_count = 100, max_labels_count = 100)

pdOn   = input.bool(true, "Previous day high / low (PDH / PDL)")
pwOn   = input.bool(true, "Previous week high / low (PWH / PWL)")
pmOn   = input.bool(true, "Previous month high / low (PMH / PML)")
ipdaOn = input.bool(false, "IPDA ranges (20 / 40 / 60 days)", tooltip = "Highest high and lowest low of the last 20, 40 and 60 daily candles.")
dayCol = input.color(#787B86, "Daily", inline = "c")
wkCol  = input.color(#2962FF, "Weekly", inline = "c")
moCol  = input.color(#9C27B0, "Monthly", inline = "c")
ipCol  = input.color(#FF9800, "IPDA", inline = "c")

TRANSP = color.new(color.white, 100)
tfSec  = timeframe.in_seconds()
lvlX   = bar_index + 15

[pdh, pdl, h20, l20, h40, l40, h60, l60] = request.security(syminfo.tickerid, "D", [high[1], low[1], ta.highest(high, 20)[1], ta.lowest(low, 20)[1], ta.highest(high, 40)[1], ta.lowest(low, 40)[1], ta.highest(high, 60)[1], ta.lowest(low, 60)[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

newDay   = timeframe.change("D")
newWeek  = timeframe.change("W")
newMonth = timeframe.change("M")
var int dayStart   = na
var int weekStart  = na
var int monthStart = na
if newDay
    dayStart := bar_index
if newWeek
    weekStart := bar_index
if newMonth
    monthStart := bar_index

var array<line>  tmpLines  = array.new<line>()
var array<label> tmpLabels = array.new<label>()

drawLevel(x1, y, c, txt) =>
    if not na(x1) and not na(y)
        x = math.max(x1, bar_index - 4999)
        array.push(tmpLines, line.new(x, y, lvlX, y, color = c))
        array.push(tmpLabels, label.new(lvlX, y, txt, color = TRANSP, textcolor = c, style = label.style_label_left, size = size.small))
    true

if barstate.islast
    for ln in tmpLines
        line.delete(ln)
    for lb in tmpLabels
        label.delete(lb)
    array.clear(tmpLines)
    array.clear(tmpLabels)
    if pdOn and tfSec < 86400
        drawLevel(dayStart, pdh, dayCol, "PDH")
        drawLevel(dayStart, pdl, dayCol, "PDL")
    if pwOn and tfSec < 604800
        drawLevel(weekStart, pwh, wkCol, "PWH")
        drawLevel(weekStart, pwl, wkCol, "PWL")
    if pmOn and tfSec < timeframe.in_seconds("1M")
        drawLevel(monthStart, pmh, moCol, "PMH")
        drawLevel(monthStart, pml, moCol, "PML")
    if ipdaOn and tfSec <= 86400
        drawLevel(dayStart, h20, ipCol, "IPDA 20D High")
        drawLevel(dayStart, l20, ipCol, "IPDA 20D Low")
        drawLevel(dayStart, h40, ipCol, "IPDA 40D High")
        drawLevel(dayStart, l40, ipCol, "IPDA 40D Low")
        drawLevel(dayStart, h60, ipCol, "IPDA 60D High")
        drawLevel(dayStart, l60, ipCol, "IPDA 60D Low")

alertcondition(ta.crossover(high, pdh), "PDH taken", "ICT: previous day high taken on {{ticker}}")
alertcondition(ta.crossunder(low, pdl), "PDL taken", "ICT: previous day low taken on {{ticker}}")
alertcondition(ta.crossover(high, pwh), "PWH taken", "ICT: previous week high taken on {{ticker}}")
alertcondition(ta.crossunder(low, pwl), "PWL taken", "ICT: previous week low taken on {{ticker}}")
