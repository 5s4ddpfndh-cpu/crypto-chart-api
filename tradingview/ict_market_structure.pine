// ICT Market Structure: BOS (break of structure) and MSS / CHoCH (market structure shift)
//@version=5
indicator("ICT Market Structure (BOS / MSS)", "ICT Structure", overlay = true, max_lines_count = 500, max_labels_count = 500)

swingLen  = input.int(5, "Swing length", minval = 2, maxval = 50, tooltip = "Bars on each side of a swing high / low. Small = internal structure, large = external structure.")
confirmBy = input.string("Close", "Break confirmation", options = ["Close", "Wick"])
maxShown  = input.int(20, "Max breaks shown", minval = 1, maxval = 200)
showSwing = input.bool(true, "Label swing points (HH / HL / LH / LL)")
bullCol   = input.color(#089981, "Bullish", inline = "c")
bearCol   = input.color(#F23645, "Bearish", inline = "c")

TRANSP = color.new(color.white, 100)
var array<line>  brkLines  = array.new<line>()
var array<label> brkLabels = array.new<label>()
var array<label> swLabels  = array.new<label>()

pushLine(array<line> arr, line l, int maxN) =>
    array.push(arr, l)
    if array.size(arr) > maxN
        line.delete(array.shift(arr))
    true

pushLabel(array<label> arr, label l, int maxN) =>
    array.push(arr, l)
    if array.size(arr) > maxN
        label.delete(array.shift(arr))
    true

drawBreak(int x1, float y, bool isBull, bool isMSS) =>
    c = isBull ? bullCol : bearCol
    pushLine(brkLines, line.new(x1, y, bar_index, y, color = c, style = isMSS ? line.style_solid : line.style_dashed), maxShown)
    pushLabel(brkLabels, label.new(math.round((x1 + bar_index) / 2), y, isMSS ? "MSS" : "BOS", color = TRANSP, textcolor = c, style = isBull ? label.style_label_down : label.style_label_up, size = size.small), maxShown)
    true

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float shPrice = na
var int   shBar   = na
var bool  shDone  = true
var float slPrice = na
var int   slBar   = na
var bool  slDone  = true
var float prevPH  = na
var float prevPL  = na
var int   trend   = 0

if not na(ph)
    if showSwing
        pushLabel(swLabels, label.new(bar_index - swingLen, ph, na(prevPH) ? "H" : ph > prevPH ? "HH" : "LH", color = TRANSP, textcolor = color.gray, style = label.style_label_down, size = size.tiny), maxShown * 2)
    prevPH  := ph
    shPrice := ph
    shBar   := bar_index - swingLen
    shDone  := false
if not na(pl)
    if showSwing
        pushLabel(swLabels, label.new(bar_index - swingLen, pl, na(prevPL) ? "L" : pl < prevPL ? "LL" : "HL", color = TRANSP, textcolor = color.gray, style = label.style_label_up, size = size.tiny), maxShown * 2)
    prevPL  := pl
    slPrice := pl
    slBar   := bar_index - swingLen
    slDone  := false

upSrc     = confirmBy == "Close" ? close : high
dnSrc     = confirmBy == "Close" ? close : low
bullBreak = not shDone and upSrc > shPrice
bearBreak = not slDone and dnSrc < slPrice
bullMSS   = bullBreak and trend == -1
bearMSS   = bearBreak and trend == 1

if bullBreak
    drawBreak(shBar, shPrice, true, bullMSS)
    shDone := true
    trend  := 1
if bearBreak
    drawBreak(slBar, slPrice, false, bearMSS)
    slDone := true
    trend  := -1

alertcondition(bullMSS, "Bullish MSS", "ICT: bullish market structure shift on {{ticker}} ({{interval}})")
alertcondition(bearMSS, "Bearish MSS", "ICT: bearish market structure shift on {{ticker}} ({{interval}})")
alertcondition(bullBreak and not bullMSS, "Bullish BOS", "ICT: bullish break of structure on {{ticker}} ({{interval}})")
alertcondition(bearBreak and not bearMSS, "Bearish BOS", "ICT: bearish break of structure on {{ticker}} ({{interval}})")
