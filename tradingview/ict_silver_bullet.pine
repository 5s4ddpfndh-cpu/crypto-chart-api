// ICT Silver Bullet windows (New York time) and the FVGs that form inside them
//@version=5
indicator("ICT Silver Bullet", "ICT Silver Bullet", overlay = true, max_boxes_count = 500)

maxTF    = input.int(15, "Only on timeframes up to (minutes)", minval = 1, tooltip = "The Silver Bullet is traded on 1m to 15m charts.")
keepDays = input.int(5, "Days to keep", minval = 1, maxval = 50)
lonOn    = input.bool(true, "", inline = "lon")
lonCol   = input.color(#2962FF, "London 03:00 - 04:00", inline = "lon")
amOn     = input.bool(true, "", inline = "am")
amCol    = input.color(#089981, "NY AM 10:00 - 11:00", inline = "am")
pmOn     = input.bool(true, "", inline = "pm")
pmCol    = input.color(#9C27B0, "NY PM 14:00 - 15:00", inline = "pm")
showFVG  = input.bool(true, "Highlight FVGs that form inside the window")
fvgCol   = input.color(color.new(#FFEB3B, 70), "FVG color")
maxFVG   = input.int(10, "Max FVGs shown", minval = 1, maxval = 50)

type Zone
    box  bx
    bool bull

TZ    = "America/New_York"
sbOK  = timeframe.isintraday and timeframe.in_seconds() <= maxTF * 60
zoneX = bar_index + 3
var array<Zone> fvgs = array.new<Zone>()

sbWindow(sess, show, txt, c) =>
    active = not na(time(timeframe.period, sess, TZ))
    var box  bx    = na
    var bool wasIn = false
    var array<box> boxes = array.new<box>()
    if show and active and not wasIn
        bx := box.new(bar_index, high, bar_index, low, border_color = color.new(c, 40), bgcolor = color.new(c, 88), text = txt, text_color = color.new(c, 10), text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
        array.push(boxes, bx)
        if array.size(boxes) > keepDays
            box.delete(array.shift(boxes))
    else if show and active
        box.set_top(bx, math.max(box.get_top(bx), high))
        box.set_bottom(bx, math.min(box.get_bottom(bx), low))
        box.set_right(bx, bar_index)
    wasIn := active
    show and active

inLon = sbWindow("0300-0400", sbOK and lonOn, "SB London", lonCol)
inAm  = sbWindow("1000-1100", sbOK and amOn, "SB NY AM", amCol)
inPm  = sbWindow("1400-1500", sbOK and pmOn, "SB NY PM", pmCol)
inAny = inLon or inAm or inPm

// FVGs from the window stay until price fills them
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        z      = array.get(fvgs, i)
        filled = z.bull ? low <= box.get_bottom(z.bx) : high >= box.get_top(z.bx)
        if filled
            array.remove(fvgs, i)
            box.delete(z.bx)
        else
            box.set_right(z.bx, zoneX)

addFVG(float top, float bot, bool isBull) =>
    array.push(fvgs, Zone.new(box.new(bar_index - 2, top, zoneX, bot, border_color = color.new(fvgCol, 30), bgcolor = fvgCol, text = isBull ? "SB Bull FVG" : "SB Bear FVG", text_color = color.new(fvgCol, 0), text_size = size.tiny, text_halign = text.align_right), isBull))
    if array.size(fvgs) > maxFVG
        old = array.shift(fvgs)
        box.delete(old.bx)
    true

bullFVG = inAny and low > high[2]
bearFVG = inAny and high < low[2]
if showFVG and bullFVG
    addFVG(low, high[2], true)
if showFVG and bearFVG
    addFVG(low[2], high, false)

alertcondition(inAny and not inAny[1], "Silver Bullet window start", "ICT: Silver Bullet window started on {{ticker}}")
alertcondition(bullFVG, "Bullish FVG in Silver Bullet", "ICT: bullish FVG inside the Silver Bullet window on {{ticker}} ({{interval}})")
alertcondition(bearFVG, "Bearish FVG in Silver Bullet", "ICT: bearish FVG inside the Silver Bullet window on {{ticker}} ({{interval}})")
