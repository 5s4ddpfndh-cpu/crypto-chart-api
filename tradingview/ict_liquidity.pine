// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ICT Liquidity: buy-side (BSL) above swing highs, sell-side (SSL) below swing lows, equal highs / lows and sweeps
//@version=5
indicator("ICT Liquidity (BSL / SSL / EQH / EQL)", "ICT Liquidity", overlay = true, max_lines_count = 500, max_labels_count = 500)

swingLen  = input.int(10, "Swing length", minval = 2, maxval = 50)
maxLevels = input.int(5, "Max levels per side", minval = 1, maxval = 30)
eqThr     = input.float(0.1, "Equal highs / lows tolerance (x ATR)", minval = 0, step = 0.05)
keepTaken = input.bool(true, "Keep taken levels and mark sweeps", tooltip = "Sweep = wick through the level and close back on the other side (stop raid / turtle soup).")
bslCol    = input.color(#F23645, "BSL", inline = "c")
sslCol    = input.color(#089981, "SSL", inline = "c")

type Liq
    line  ln
    label lb
    float price
    bool  eq

TRANSP = color.new(color.white, 100)
atr    = ta.atr(14)
zoneX  = bar_index + 3
var array<Liq> bslArr  = array.new<Liq>()
var array<Liq> sslArr  = array.new<Liq>()
var array<Liq> liqDone = array.new<Liq>()

manageLiq(array<Liq> arr, bool isHigh) =>
    bool swept = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            q     = array.get(arr, i)
            taken = isHigh ? high > q.price : low < q.price
            if taken
                array.remove(arr, i)
                raid  = isHigh ? close < q.price : close > q.price
                swept := swept or raid
                if keepTaken
                    c = raid ? (isHigh ? bslCol : sslCol) : color.gray
                    line.set_x2(q.ln, bar_index)
                    line.set_style(q.ln, line.style_dotted)
                    line.set_color(q.ln, c)
                    label.set_x(q.lb, bar_index)
                    label.set_text(q.lb, (q.eq ? (isHigh ? "EQH" : "EQL") : (isHigh ? "BSL" : "SSL")) + (raid ? " sweep" : " taken"))
                    label.set_textcolor(q.lb, c)
                    array.push(liqDone, q)
                    if array.size(liqDone) > maxLevels * 2
                        old = array.shift(liqDone)
                        line.delete(old.ln)
                        label.delete(old.lb)
                else
                    line.delete(q.ln)
                    label.delete(q.lb)
            else
                line.set_x2(q.ln, zoneX)
                label.set_x(q.lb, zoneX)
    swept

addLiq(array<Liq> arr, float price, int x, bool isHigh) =>
    bool merged = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            q = array.get(arr, i)
            if math.abs(q.price - price) <= atr * eqThr
                q.eq    := true
                q.price := isHigh ? math.max(q.price, price) : math.min(q.price, price)
                line.set_y1(q.ln, q.price)
                line.set_y2(q.ln, q.price)
                line.set_width(q.ln, 2)
                label.set_y(q.lb, q.price)
                label.set_text(q.lb, isHigh ? "EQH" : "EQL")
                merged := true
                break
    if not merged
        c  = isHigh ? bslCol : sslCol
        ln = line.new(x, price, zoneX, price, color = c, style = line.style_dashed)
        lb = label.new(zoneX, price, isHigh ? "BSL" : "SSL", color = TRANSP, textcolor = c, style = label.style_label_left, size = size.tiny)
        array.push(arr, Liq.new(ln, lb, price, false))
        if array.size(arr) > maxLevels
            old = array.shift(arr)
            line.delete(old.ln)
            label.delete(old.lb)
    merged

bslSweep = manageLiq(bslArr, true)
sslSweep = manageLiq(sslArr, false)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
if not na(ph)
    addLiq(bslArr, ph, bar_index - swingLen, true)
if not na(pl)
    addLiq(sslArr, pl, bar_index - swingLen, false)

alertcondition(bslSweep, "Buy-side liquidity sweep", "ICT: buy-side liquidity swept on {{ticker}} ({{interval}})")
alertcondition(sslSweep, "Sell-side liquidity sweep", "ICT: sell-side liquidity swept on {{ticker}} ({{interval}})")
