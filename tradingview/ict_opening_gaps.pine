// ICT Opening Gaps: New Week Opening Gap (NWOG) and New Day Opening Gap (NDOG) with their 50% level
//@version=5
indicator("ICT Opening Gaps (NWOG / NDOG)", "ICT NWOG/NDOG", overlay = true, max_boxes_count = 100, max_lines_count = 100)

nwogOn  = input.bool(true, "New week opening gap (NWOG)", inline = "w", tooltip = "Gap between Friday's close and the new week's open. Markets that trade 24/7 (crypto) rarely have one.")
nwogCol = input.color(color.new(#FF5252, 85), "", inline = "w")
ndogOn  = input.bool(true, "New day opening gap (NDOG)", inline = "d", tooltip = "Gap between the previous session close and the new day's open (futures and forex).")
ndogCol = input.color(color.new(#00BCD4, 85), "", inline = "d")
maxGaps = input.int(5, "Max gaps of each type", minval = 1, maxval = 20)
showCE  = input.bool(true, "Show 50% line (CE)")

type Zone
    box  bx
    line ce

zoneX = bar_index + 3
tfSec = timeframe.in_seconds()
var array<Zone> nwogs = array.new<Zone>()
var array<Zone> ndogs = array.new<Zone>()

extendAll(array<Zone> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            z = array.get(arr, i)
            box.set_right(z.bx, zoneX)
            if not na(z.ce)
                line.set_x2(z.ce, zoneX)
    true

makeGap(array<Zone> arr, string txt, color c, float prevClose) =>
    gTop = math.max(open, prevClose)
    gBot = math.min(open, prevClose)
    if gTop - gBot > syminfo.mintick
        bx = box.new(bar_index - 1, gTop, zoneX, gBot, border_color = color.new(c, 40), bgcolor = c, text = txt, text_color = color.new(c, 0), text_size = size.tiny, text_halign = text.align_right)
        ce = showCE ? line.new(bar_index - 1, (gTop + gBot) / 2, zoneX, (gTop + gBot) / 2, color = color.new(c, 40), style = line.style_dotted) : na
        array.push(arr, Zone.new(bx, ce))
        if array.size(arr) > maxGaps
            old = array.shift(arr)
            box.delete(old.bx)
            line.delete(old.ce)
    true

extendAll(nwogs)
extendAll(ndogs)
prevClose = close[1]
newWeek   = timeframe.change("W")
newDay    = timeframe.change("D")
if nwogOn and newWeek and tfSec < 604800 and bar_index > 0
    makeGap(nwogs, "NWOG", nwogCol, prevClose)
if ndogOn and newDay and tfSec < 86400 and bar_index > 0
    makeGap(ndogs, "NDOG", ndogCol, prevClose)
