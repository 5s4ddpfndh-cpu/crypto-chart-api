// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ICT Order Blocks
// Bullish OB = last down-close candle before the up move that breaks a swing high (BOS / MSS)
// Bearish OB = last up-close candle before the down move that breaks a swing low
// Optional ICT filter: the move must be a displacement that leaves a fair value gap (FVG)
// Order blocks are never deleted: fresh -> mitigated (price came back into it) -> broken (closed through it, turns gray)
//@version=5
indicator("ICT Order Blocks", "ICT OB", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_bars_back = 500)

swingLen  = input.int(5, "Swing length", minval = 2, maxval = 50, tooltip = "Bars on each side of the swing high / low that must be broken. Small = more OBs (internal structure), large = fewer, stronger OBs.")
needFVG   = input.bool(true, "Require displacement (FVG after the OB)", tooltip = "ICT: a valid order block is followed by a strong move that leaves a fair value gap.")
useBody   = input.bool(false, "Use candle body (instead of wicks)")
showMT    = input.bool(true, "Show mean threshold (50% line)")
maxActive = input.int(10, "Max OBs still extending (per side)", minval = 1, maxval = 50, tooltip = "Older OBs stop extending to the right but stay on the chart.")
bullCol   = input.color(color.new(#089981, 75), "Bullish OB", inline = "c")
bearCol   = input.color(color.new(#F23645, 75), "Bearish OB", inline = "c")
brokenCol = input.color(color.new(#787B86, 85), "Broken OB", inline = "c")

type OB
    box  bx
    line mt
    bool touched

zoneX = bar_index + 3
var array<OB> bullArr = array.new<OB>()
var array<OB> bearArr = array.new<OB>()

// Stop extending an order block (it stays on the chart)
freeze(OB o) =>
    box.set_right(o.bx, bar_index)
    if not na(o.mt)
        line.set_x2(o.mt, bar_index)
    true

extendOB(OB o) =>
    box.set_right(o.bx, zoneX)
    if not na(o.mt)
        line.set_x2(o.mt, zoneX)
    true

manage(array<OB> arr, bool isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            o      = array.get(arr, i)
            top    = box.get_top(o.bx)
            bot    = box.get_bottom(o.bx)
            broken = isBull ? close < bot : close > top
            if broken
                array.remove(arr, i)
                box.set_bgcolor(o.bx, brokenCol)
                box.set_border_color(o.bx, color.new(brokenCol, 40))
                box.set_text(o.bx, isBull ? "Bull OB (broken)" : "Bear OB (broken)")
                box.set_text_color(o.bx, color.gray)
                freeze(o)
            else
                if not o.touched and (isBull ? low <= top : high >= bot)
                    o.touched := true
                    box.set_border_style(o.bx, line.style_dashed)
                    box.set_text(o.bx, isBull ? "Bull OB (mitigated)" : "Bear OB (mitigated)")
                extendOB(o)
    true

addOB(array<OB> arr, float top, float bot, int left, bool isBull) =>
    c  = isBull ? bullCol : bearCol
    bx = box.new(left, top, zoneX, bot, border_color = color.new(c, 30), bgcolor = c, text = isBull ? "Bull OB" : "Bear OB", text_color = color.new(c, 0), text_size = size.small, text_halign = text.align_right)
    mt = showMT ? line.new(left, (top + bot) / 2, zoneX, (top + bot) / 2, color = color.new(c, 20), style = line.style_dashed) : na
    array.push(arr, OB.new(bx, mt, false))
    if array.size(arr) > maxActive
        freeze(array.shift(arr))
    true

// Existing order blocks are updated first, new ones are added after
manage(bullArr, true)
manage(bearArr, false)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float shPrice = na
var int   shBar   = na
var bool  shDone  = true
var float slPrice = na
var int   slBar   = na
var bool  slDone  = true
if not na(ph)
    shPrice := ph
    shBar   := bar_index - swingLen
    shDone  := false
if not na(pl)
    slPrice := pl
    slBar   := bar_index - swingLen
    slDone  := false

newBull = false
newBear = false

// Bullish OB: a candle closes above the last swing high
if not shDone and close > shPrice
    shDone := true
    n = math.min(bar_index - shBar, 450)
    float v = na
    int   k = na
    for i = 1 to n
        if close[i] < open[i] and (na(v) or low[i] < v)
            v := low[i]
            k := i
    if not na(k)
        ok = not needFVG
        if needFVG and k >= 2
            for j = 0 to k - 2
                if low[j] > high[j + 2]
                    ok := true
                    break
        if ok
            addOB(bullArr, useBody ? math.max(open[k], close[k]) : high[k], useBody ? math.min(open[k], close[k]) : low[k], bar_index - k, true)
            newBull := true

// Bearish OB: a candle closes below the last swing low
if not slDone and close < slPrice
    slDone := true
    n = math.min(bar_index - slBar, 450)
    float v = na
    int   k = na
    for i = 1 to n
        if close[i] > open[i] and (na(v) or high[i] > v)
            v := high[i]
            k := i
    if not na(k)
        ok = not needFVG
        if needFVG and k >= 2
            for j = 0 to k - 2
                if high[j] < low[j + 2]
                    ok := true
                    break
        if ok
            addOB(bearArr, useBody ? math.max(open[k], close[k]) : high[k], useBody ? math.min(open[k], close[k]) : low[k], bar_index - k, false)
            newBear := true

alertcondition(newBull, "New bullish OB", "ICT: new bullish order block on {{ticker}} ({{interval}})")
alertcondition(newBear, "New bearish OB", "ICT: new bearish order block on {{ticker}} ({{interval}})")
