// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ICT Inversion FVG: when a candle closes through a fair value gap, the gap flips and acts with the opposite role
//@version=5
indicator("ICT Inversion FVG (IFVG)", "ICT IFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500)

minATR   = input.float(0.0, "Min FVG size (x ATR)", minval = 0, step = 0.05)
maxTrack = input.int(20, "FVGs tracked", minval = 1, maxval = 100)
maxShown = input.int(5, "Max IFVGs shown", minval = 1, maxval = 50)
showFVG  = input.bool(false, "Also show FVGs before they invert")
showCE   = input.bool(true, "Show 50% line")
bullCol  = input.color(color.new(#089981, 80), "Bullish IFVG", inline = "c")
bearCol  = input.color(color.new(#F23645, 80), "Bearish IFVG", inline = "c")
fvgCol   = input.color(color.new(#787B86, 85), "FVG before inversion")

type Zone
    box  bx
    line ce
    bool bull

TRANSP = color.new(color.white, 100)
atr    = ta.atr(14)
zoneX  = bar_index + 3
var array<Zone> fvgs  = array.new<Zone>()
var array<Zone> ifvgs = array.new<Zone>()

deleteZone(Zone z) =>
    box.delete(z.bx)
    line.delete(z.ce)
    true

extendZone(Zone z) =>
    box.set_right(z.bx, zoneX)
    if not na(z.ce)
        line.set_x2(z.ce, zoneX)
    true

pushZone(array<Zone> arr, Zone z, int maxN) =>
    array.push(arr, z)
    if array.size(arr) > maxN
        deleteZone(array.shift(arr))
    true

// An inversion FVG ends when price closes back through it
if array.size(ifvgs) > 0
    for i = array.size(ifvgs) - 1 to 0
        z    = array.get(ifvgs, i)
        dead = z.bull ? close < box.get_bottom(z.bx) : close > box.get_top(z.bx)
        if dead
            array.remove(ifvgs, i)
            deleteZone(z)
        else
            extendZone(z)

// A candle that closes through an FVG flips it into an inversion FVG
newBullIFVG = false
newBearIFVG = false
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        z    = array.get(fvgs, i)
        top  = box.get_top(z.bx)
        bot  = box.get_bottom(z.bx)
        flip = z.bull ? close < bot : close > top
        if flip
            array.remove(fvgs, i)
            nb = not z.bull
            if nb
                newBullIFVG := true
            else
                newBearIFVG := true
            c = nb ? bullCol : bearCol
            box.set_bgcolor(z.bx, c)
            box.set_border_color(z.bx, color.new(c, 40))
            box.set_text(z.bx, nb ? "Bull IFVG" : "Bear IFVG")
            box.set_text_color(z.bx, color.new(c, 0))
            ce = showCE ? line.new(box.get_left(z.bx), (top + bot) / 2, zoneX, (top + bot) / 2, color = color.new(c, 30), style = line.style_dashed) : na
            pushZone(ifvgs, Zone.new(z.bx, ce, nb), maxShown)
            box.set_right(z.bx, zoneX)
        else
            box.set_right(z.bx, zoneX)

newFVG(float top, float bot, bool isBull) =>
    bx = box.new(bar_index - 2, top, zoneX, bot, border_color = showFVG ? fvgCol : TRANSP, bgcolor = showFVG ? fvgCol : TRANSP, text = showFVG ? "FVG" : "", text_color = color.new(fvgCol, 0), text_size = size.tiny, text_halign = text.align_right)
    pushZone(fvgs, Zone.new(bx, na, isBull), maxTrack)
    true

if low > high[2] and low - high[2] >= atr * minATR
    newFVG(low, high[2], true)
if high < low[2] and low[2] - high >= atr * minATR
    newFVG(low[2], high, false)

alertcondition(newBullIFVG, "New bullish IFVG", "ICT: new bullish inversion FVG on {{ticker}} ({{interval}})")
alertcondition(newBearIFVG, "New bearish IFVG", "ICT: new bearish inversion FVG on {{ticker}} ({{interval}})")
