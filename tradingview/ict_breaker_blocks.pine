// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ICT Breaker Blocks: an order block that fails (a candle closes through it) flips into a breaker with the opposite role
//@version=5
indicator("ICT Breaker Blocks", "ICT Breakers", overlay = true, max_boxes_count = 500, max_bars_back = 500)

swingLen = input.int(5, "Swing length", minval = 2, maxval = 50)
maxShown = input.int(3, "Max breakers per side", minval = 1, maxval = 20)
useBody  = input.bool(false, "Use candle body (instead of wicks)")
bullCol  = input.color(color.new(#2962FF, 80), "Bullish breaker", inline = "c")
bearCol  = input.color(color.new(#E040FB, 80), "Bearish breaker", inline = "c")

type OB
    float top
    float bot
    int   left

zoneX = bar_index + 3
var array<OB>  bullOB = array.new<OB>()
var array<OB>  bearOB = array.new<OB>()
var array<box> bullBB = array.new<box>()
var array<box> bearBB = array.new<box>()

// A breaker ends when price closes back through it
manageBreakers(array<box> arr, bool isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            b      = array.get(arr, i)
            failed = isBull ? close < box.get_bottom(b) : close > box.get_top(b)
            if failed
                array.remove(arr, i)
                box.delete(b)
            else
                box.set_right(b, zoneX)
    true

// Order blocks are tracked without being drawn. A failed bullish OB becomes a bearish breaker and vice versa
flipOBs(array<OB> arr, bool isBull, array<box> bbArr) =>
    bool made = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            o      = array.get(arr, i)
            broken = isBull ? close < o.bot : close > o.top
            if broken
                array.remove(arr, i)
                c = isBull ? bearCol : bullCol
                array.push(bbArr, box.new(o.left, o.top, zoneX, o.bot, border_color = color.new(c, 40), bgcolor = c, text = isBull ? "Bear Breaker" : "Bull Breaker", text_color = color.new(c, 0), text_size = size.tiny, text_halign = text.align_right))
                if array.size(bbArr) > maxShown
                    box.delete(array.shift(bbArr))
                made := true
    made

manageBreakers(bullBB, true)
manageBreakers(bearBB, false)
newBearBB = flipOBs(bullOB, true, bearBB)
newBullBB = flipOBs(bearOB, false, bullBB)

// Structure breaks create the order blocks
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
var float shPrice = na
var int   shBar   = na
var bool  shDone  = true
var float slPrice = na
var int   slBar   = na
var bool  slDone  = true
if not na(ph)
    shPrice := ph
    shBar   := bar_index - swingLen
    shDone  := false
if not na(pl)
    slPrice := pl
    slBar   := bar_index - swingLen
    slDone  := false

if not shDone and close > shPrice
    shDone := true
    n = math.min(bar_index - shBar, 450)
    float v = na
    int   k = na
    for i = 1 to n
        if close[i] < open[i] and (na(v) or low[i] < v)
            v := low[i]
            k := i
    if not na(k)
        array.push(bullOB, OB.new(useBody ? math.max(open[k], close[k]) : high[k], useBody ? math.min(open[k], close[k]) : low[k], bar_index - k))
        if array.size(bullOB) > 10
            array.shift(bullOB)

if not slDone and close < slPrice
    slDone := true
    n = math.min(bar_index - slBar, 450)
    float v = na
    int   k = na
    for i = 1 to n
        if close[i] > open[i] and (na(v) or high[i] > v)
            v := high[i]
            k := i
    if not na(k)
        array.push(bearOB, OB.new(useBody ? math.max(open[k], close[k]) : high[k], useBody ? math.min(open[k], close[k]) : low[k], bar_index - k))
        if array.size(bearOB) > 10
            array.shift(bearOB)

alertcondition(newBullBB, "New bullish breaker", "ICT: new bullish breaker block on {{ticker}} ({{interval}})")
alertcondition(newBearBB, "New bearish breaker", "ICT: new bearish breaker block on {{ticker}} ({{interval}})")
