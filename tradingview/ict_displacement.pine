// ICT Displacement: strong, large-bodied candles, optionally only those that leave a fair value gap
//@version=5
indicator("ICT Displacement", "ICT Displacement", overlay = true)

mode    = input.string("Body size + FVG", "Detect by", options = ["Body size", "Body size + FVG"], tooltip = "'Body size + FVG' only marks strong candles that leave a fair value gap. The candle is colored one bar later, once the gap is confirmed.")
avgLen  = input.int(20, "Average body length", minval = 2)
mult    = input.float(1.5, "Body size (x average body)", minval = 1, step = 0.1)
bullCol = input.color(#00E676, "Bullish", inline = "c")
bearCol = input.color(#FF1744, "Bearish", inline = "c")

body    = math.abs(close - open)
avgBody = ta.sma(body, avgLen)
big     = body > avgBody[1] * mult
bigBull = big and close > open
bigBear = big and close < open

// Mode 1: the strong candle itself
bySize = mode == "Body size"
barcolor(bySize and bigBull ? bullCol : bySize and bigBear ? bearCol : na, title = "Displacement")

// Mode 2: the middle candle of a fair value gap, colored when the third candle confirms the gap
dBull = not bySize and bigBull[1] and low > high[2]
dBear = not bySize and bigBear[1] and high < low[2]
barcolor(dBull ? bullCol : dBear ? bearCol : na, offset = -1, title = "Displacement + FVG")

alertcondition(bySize ? bigBull : dBull, "Bullish displacement", "ICT: bullish displacement on {{ticker}} ({{interval}})")
alertcondition(bySize ? bigBear : dBear, "Bearish displacement", "ICT: bearish displacement on {{ticker}} ({{interval}})")
